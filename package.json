{
  "name": "onlybans-glider",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bash scripts/build.sh",
    "test": "node --test test/*.test.js",
    "check:layout": "node scripts/check-layout.mjs",
    "check:stealth": "node scripts/check-stealth.mjs",
    "release": "npm run build && npm test && npm run check:layout && npm run check:stealth",
    "e2e":"npm run build && node scripts/e2e.mjs",
    "sim": "npm run build && node scripts/sim/run.mjs",
    "experiments": "npm run build && node scripts/sim/experiments.mjs",
    "progress": "node scripts/sim/progress.mjs"
  },
  "devDependencies": {
    "@sinonjs/fake-timers": "^13.0.5",
    "jsdom": "^25.0.1",
    "playwright": "^1.58.2"
  }
}
